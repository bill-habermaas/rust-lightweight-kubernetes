{
  "version": "2.0.0",
  "tasks": [
    { "label": "cargo build", "type": "shell", "command": "cargo build", "group": { "kind": "build", "isDefault": true }, "problemMatcher": ["$rustc"] },
    { "label": "cargo test", "type": "shell", "command": "cargo test", "group": { "kind": "test", "isDefault": true }, "problemMatcher": ["$rustc"] },
    { "label": "cargo clippy", "type": "shell", "command": "cargo clippy --all-targets", "problemMatcher": ["$rustc"] },
    {
      "label": "run server (memory store, mock runtime)",
      "type": "shell",
      "command": "cargo run",
      "options": { "env": { "LKUBE_STORE": "memory", "LKUBE_RUNTIME": "mock", "LKUBE_NODE_NAME": "node-1", "RUST_LOG": "info" } },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "run server (local MongoDB + Docker)",
      "type": "shell",
      "command": "cargo run",
      "options": { "env": { "LKUBE_STORE": "mongo", "LKUBE_MONGO_URI": "mongodb://localhost:27017", "LKUBE_RUNTIME": "docker", "LKUBE_NODE_NAME": "node-1", "RUST_LOG": "info" } },
      "isBackground": true,
      "problemMatcher": []
    },
    { "label": "mongo: start (docker)", "type": "shell", "command": "docker run -d --rm --name lkube-dev-mongo -p 27017:27017 mongo:7", "problemMatcher": [] },
    { "label": "mongo: store tests", "type": "shell", "command": "cargo test --test mongo_store", "options": { "env": { "LKUBE_TEST_MONGO_URI": "mongodb://localhost:27017" } }, "problemMatcher": ["$rustc"] },
    { "label": "ui: install", "type": "shell", "command": "npm install", "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "ui: dev server", "type": "shell", "command": "npm run dev", "options": { "cwd": "${workspaceFolder}/frontend" }, "isBackground": true, "problemMatcher": [] },
    { "label": "ui: test", "type": "shell", "command": "npm test", "options": { "cwd": "${workspaceFolder}/frontend" }, "group": "test", "problemMatcher": [] },
    { "label": "ui: regenerate gRPC client", "type": "shell", "command": "npm run gen", "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "compose: up", "type": "shell", "command": "docker compose up -d --build", "problemMatcher": [] },
    { "label": "compose: up with example operator", "type": "shell", "command": "docker compose --profile operators up -d --build", "problemMatcher": [] },
    { "label": "compose: logs", "type": "shell", "command": "docker compose logs -f lkube-server", "isBackground": true, "problemMatcher": [] },
    { "label": "compose: down", "type": "shell", "command": "docker compose down", "problemMatcher": [] }
  ]
}
